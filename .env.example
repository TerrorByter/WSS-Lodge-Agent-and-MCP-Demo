# Copy this file to .env and paste your OpenRouter key after the = sign (no quotes, no spaces).
# Never share or commit your .env file: it holds your secret key.
OPENROUTER_API_KEY=

# Optional: another Claude model (slugs at https://openrouter.ai/models). The default is anthropic/claude-sonnet-4.6
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
